{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "lib": ["ES2022", "DOM"],
    "strict": false, "noImplicitThis": true, "strictFunctionTypes": true, "strictBindCallApply": true, "noImplicitAny": true, "noEmit": true,
    "skipLibCheck": true, "allowJs": false
  },
  "include": ["src/**/*.ts"]
}
